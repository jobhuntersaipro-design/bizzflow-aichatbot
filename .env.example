# Neon PostgreSQL (pooled). Migrations derive the direct endpoint, or set DIRECT_DATABASE_URL.
DATABASE_URL=
# NextAuth session secret: `openssl rand -base64 32`
AUTH_SECRET=

# Claude (auto-reply and chat sorting)
ANTHROPIC_API_KEY=
WHATSAPP_AI_MODEL=
WHATSAPP_CRM_MODEL=

# WhatsApp through Dualhook (Meta Cloud API, Coexistence)
DUALHOOK_API_KEY=
DUALHOOK_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
# Secret path segment: the webhook is /api/whatsapp/dualhook/<this>
WHATSAPP_WEBHOOK_PATH_KEY=

# Optional: the older QR gateway on the BizzFlow droplet
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=

# BizzFlow API (Order Entry drafts, order and case lookups)
BIZZFLOW_API_URL=https://bizzflow.top
NEXT_PUBLIC_BIZZFLOW_URL=https://bizzflow.top
CHATBOT_API_SECRET=

# Vercel Cron bearer token
CRON_SECRET=

# Local only: show fixture chats without a database
WHATSAPP_INBOX_FIXTURE=
